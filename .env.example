UNMC_RAG_APP_NAME=UNMC 课程助手
UNMC_RAG_SCHOOL_EMAIL_DOMAIN=unmc.edu
# 主题门禁关键词；接入 Current Students 语料时可追加英文主题词。
UNMC_RAG_COURSE_TERMS=高等数学,微积分,线性代数,graduation,shuttle,counselling,timetable,appeals,examination,visa,wellbeing,amenities
# 关键词检索原型建议 0.25–0.4；向量检索阶段再调高。
UNMC_RAG_MINIMUM_RETRIEVAL_SCORE=0.3
# 启用本地抓取语料检索时填写；留空则 EmptyRetriever（测试默认行为）。
UNMC_RAG_CORPUS_PATH=data/scraped/current_students/documents.jsonl
UNMC_RAG_CHUNK_SIZE=500
UNMC_RAG_CHUNK_OVERLAP=80
UNMC_RAG_RETRIEVAL_TOP_K=5

POSTGRES_DB=unmc_rag
POSTGRES_USER=unmc_rag
POSTGRES_PASSWORD=change-me-before-deploying
# 预留给下一阶段数据库接线；当前 M0 API 尚不读取此变量。
DATABASE_URL=postgresql+asyncpg://unmc_rag:change-me-before-deploying@db:5432/unmc_rag

# 智谱 GLM（OpenAI 兼容）。切勿提交真实密钥到 Git。
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/
LLM_API_KEY=
LLM_MODEL=glm-4.5-air
EMBEDDING_MODEL=
