# Local / Docker Compose environment.
# Copy to .env and fill in secrets:
#   cp .env.example .env
#
# Coolify (GitHub App): paste .env.coolify.example into Environment Variables.
# Do not set APP_IMAGE there — Coolify builds from Git.

# Optional local tag for `make docker-build` / TCR only. Unused by compose.yaml.
# APP_IMAGE=unmc-rag:local

UNMC_RAG_APP_NAME=UNMC Course Assistant
UNMC_RAG_SCHOOL_EMAIL_DOMAIN=unmc.edu
# Topic-gate keywords; append Current Students terms when using that corpus.
UNMC_RAG_COURSE_TERMS=calculus,linear algebra,graduation,shuttle,counselling,timetable,appeals,examination,visa,wellbeing,amenities
# Keyword-retrieval prototype: try 0.25–0.4; raise again for vector search.
UNMC_RAG_MINIMUM_RETRIEVAL_SCORE=0.3
# Baked into the backend image; override only if you mount a different corpus.
UNMC_RAG_CORPUS_PATH=data/scraped/current_students/documents.jsonl
UNMC_RAG_CHUNK_SIZE=500
UNMC_RAG_CHUNK_OVERLAP=80
UNMC_RAG_RETRIEVAL_TOP_K=5

# Host must be the Supabase Session pooler (IPv4). Copy from Dashboard → Connect.
# User: postgres.<project-ref>  Port: 5432  (transaction mode is 6543; this app uses 5432)
# DATABASE_URL=postgresql+asyncpg://postgres.mqyqcoxzapzwkuxvctcv:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Zhipu GLM (OpenAI-compatible). Never commit a real key to Git.
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/
LLM_API_KEY=
LLM_MODEL=glm-4.5-air
EMBEDDING_MODEL=
