# Coolify (GitHub App) environment for Dockerfile.coolify.
# Resource: Docker Compose · compose file: docker-compose.yaml · branch: main
# Domain → service `app` · port 80
# Do NOT set APP_IMAGE. Do not commit real keys. Paste this into
# Coolify → Environment Variables, then fill the three CHANGE_ME values.
#
# /setting writes prompts into the container copy of conditions.json.
# Those edits disappear on the next redeploy unless you mount a volume
# over app/experiment/conditions.json.

UNMC_RAG_APP_NAME=UNMC Course Assistant
UNMC_RAG_SCHOOL_EMAIL_DOMAIN=unmc.edu
UNMC_RAG_COURSE_TERMS=calculus,linear algebra,graduation,shuttle,counselling,timetable,appeals,examination,visa,wellbeing,amenities,nfp,progression,attendance,grading,misconduct,module,assessment,admissions,complaints
UNMC_RAG_MINIMUM_RETRIEVAL_SCORE=0.3
UNMC_RAG_CORPUS_PATH=data/scraped/current_students/documents.jsonl,data/scraped/nfp/documents.jsonl
UNMC_RAG_CHUNK_SIZE=500
UNMC_RAG_CHUNK_OVERLAP=80
UNMC_RAG_RETRIEVAL_TOP_K=5
UNMC_RAG_EXPERIMENT_HISTORY_MESSAGES=16
# Leave empty to use the conditions.json baked into the image.
UNMC_RAG_EXPERIMENT_CONDITIONS_PATH=
# Required. 32-byte key for participant emails and transcripts:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
UNMC_RAG_DATA_ENCRYPTION_KEY=CHANGE_ME

# Session pooler, port 5432, IPv4. Not the https://*.supabase.co API URL.
# postgresql+asyncpg://postgres.<project-ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=CHANGE_ME

LLM_API_BASE=https://api.deepseek.com/
LLM_API_KEY=CHANGE_ME
LLM_MODEL=deepseek-flash
EMBEDDING_MODEL=

# Optional. Empty SMTP_HOST means the 96h probe runs but does not send mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_TO_ADDRESS=yellow.sea@live.cn
SMTP_USE_TLS=true
UNMC_RAG_PROBE_ENABLED=true
UNMC_RAG_PROBE_INTERVAL_HOURS=96
UNMC_RAG_PROBE_STARTUP_DELAY_SECONDS=120
UNMC_RAG_PROBE_QUESTION=When is the next graduation ceremony?
