# Coolify (GitHub App) → Environment Variables
# Do NOT set APP_IMAGE — Coolify builds from Git.
# Copy DATABASE_URL and LLM_API_KEY from local .env / .env.coolify.
#
# 1. Resource type: Docker Compose
# 2. Compose file: docker-compose.yaml  (or compose.yaml — they match)
# 3. Branch: main
# 4. Domain → service `app`, port 80
# 5. Redeploy after pushing these config fixes

UNMC_RAG_APP_NAME=UNMC Course Assistant
UNMC_RAG_SCHOOL_EMAIL_DOMAIN=unmc.edu
UNMC_RAG_COURSE_TERMS=calculus,linear algebra,graduation,shuttle,counselling,timetable,appeals,examination,visa,wellbeing,amenities
UNMC_RAG_MINIMUM_RETRIEVAL_SCORE=0.3
UNMC_RAG_CORPUS_PATH=data/scraped/current_students/documents.jsonl
UNMC_RAG_CHUNK_SIZE=500
UNMC_RAG_CHUNK_OVERLAP=80
UNMC_RAG_RETRIEVAL_TOP_K=5

# Session pooler (port 5432). postgresql+asyncpg://... not an https:// dashboard URL.
DATABASE_URL=

LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/
LLM_API_KEY=CHANGE_ME_ZHIPU_API_KEY
LLM_MODEL=glm-4.5-air
EMBEDDING_MODEL=
