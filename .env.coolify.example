# Coolify (GitHub App) → Environment Variables
# Resource: Docker Compose · compose file: docker-compose.yaml · branch: unmc_exp
# Domain → service `app` · port 80
# Do NOT set APP_IMAGE. Do not commit real keys.
#
# 1. Push this branch (must include data/scraped/current_students/documents.jsonl).
# 2. Coolify → Docker Compose → docker-compose.yaml (not compose.local.yaml).
# 3. Paste this file, fill DATABASE_URL, LLM_API_KEY, and UNMC_RAG_DATA_ENCRYPTION_KEY.
# 4. Domain → service `app`, container port 80.

UNMC_RAG_APP_NAME=UNMC Course Assistant
UNMC_RAG_SCHOOL_EMAIL_DOMAIN=unmc.edu
UNMC_RAG_COURSE_TERMS=calculus,linear algebra,graduation,shuttle,counselling,timetable,appeals,examination,visa,wellbeing,amenities
UNMC_RAG_MINIMUM_RETRIEVAL_SCORE=0.3
UNMC_RAG_CORPUS_PATH=data/scraped/current_students/documents.jsonl
UNMC_RAG_CHUNK_SIZE=500
UNMC_RAG_CHUNK_OVERLAP=80
UNMC_RAG_RETRIEVAL_TOP_K=5
UNMC_RAG_EXPERIMENT_HISTORY_MESSAGES=16
# UNMC_RAG_EXPERIMENT_CONDITIONS_PATH=
# Required for encrypted participant emails/transcripts. Generate once and keep it:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
UNMC_RAG_DATA_ENCRYPTION_KEY=

# Session pooler (port 5432, IPv4). Use the unmc_rag_app role, not the dashboard HTTPS URL.
# postgresql+asyncpg://unmc_rag_app.mqyqcoxzapzwkuxvctcv:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/
LLM_API_KEY=CHANGE_ME_ZHIPU_API_KEY
LLM_MODEL=glm-4.5-air
EMBEDDING_MODEL=
