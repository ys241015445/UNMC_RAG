# Coolify (GitHub App) → Environment Variables
# Resource: Docker Compose · compose file: docker-compose.yaml · branch: main
# Domain → service `app` · port 80
# Do NOT set APP_IMAGE. Copy DATABASE_URL and LLM_API_KEY from .env.coolify.

UNMC_RAG_APP_NAME=UNMC Course Assistant
UNMC_RAG_SCHOOL_EMAIL_DOMAIN=unmc.edu
UNMC_RAG_COURSE_TERMS=calculus,linear algebra,graduation,shuttle,counselling,timetable,appeals,examination,visa,wellbeing,amenities,quality manual,academic regulations,assessment,admissions,complaints
UNMC_RAG_MINIMUM_RETRIEVAL_SCORE=0.3
UNMC_RAG_CORPUS_PATH=data/scraped/current_students/documents.jsonl,data/scraped/quality_manual/documents.jsonl
UNMC_RAG_CHUNK_SIZE=500
UNMC_RAG_CHUNK_OVERLAP=80
UNMC_RAG_RETRIEVAL_TOP_K=5

# Session pooler port 5432. Must be postgresql:// or postgresql+asyncpg:// (not https://).
DATABASE_URL=

LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/
LLM_API_KEY=CHANGE_ME_ZHIPU_API_KEY
LLM_MODEL=glm-4.5-air
EMBEDDING_MODEL=

# Simulated query every 96h; emails yellow.sea@live.cn on failure.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_TO_ADDRESS=yellow.sea@live.cn
SMTP_USE_TLS=true
UNMC_RAG_PROBE_ENABLED=true
UNMC_RAG_PROBE_INTERVAL_HOURS=96
UNMC_RAG_PROBE_STARTUP_DELAY_SECONDS=120
